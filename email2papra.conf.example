[papra]
# URL of your Papra intake-emails endpoint
webhook_url    = https://your-papra-instance.example.com/api/intake-emails/ingest

# Must match INTAKE_EMAILS_WEBHOOK_SECRET in your Papra docker-compose.yml
# Generate with: openssl rand -hex 32
webhook_secret = replace-with-your-secret

# The Papra-generated intake address (shown in Papra UI under "Intake Emails")
# All incoming mail is forwarded to this address regardless of the original To: header
intake_address = your-slug@your-domain.example.com

# HTTP request timeout in seconds
timeout        = 30
